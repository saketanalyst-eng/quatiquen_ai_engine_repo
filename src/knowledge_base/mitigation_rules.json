  "default_mitigation": {
    "description": "Default mitigation for uncategorized findings",
    "mitigations": [
      "Assess the finding and determine the appropriate remediation",
      "Consult security documentation and vendor guidance",
      "Escalate to the security team if needed",
      "Apply standard security hardening practices"
    ],
    "time_to_mitigate": {
      "critical": "24 hours",
      "high": "72 hours",
      "medium": "7 days",
      "low": "30 days"
    }
