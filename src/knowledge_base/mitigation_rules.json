    "general": {
      "description": "General security findings",
      "mitigations": [
        "Investigate root cause",
        "Apply appropriate security controls",
        "Document remediation actions",
        "Verify resolution",
        "Update security policies if needed"
      ],
      "time_to_mitigate": {
        "critical": "24 hours",
        "high": "72 hours",
        "medium": "7 days",
        "low": "30 days"
      }
    }
